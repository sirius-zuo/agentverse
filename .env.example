# AgentVerse Environment Variables
# Copy to .env and fill in your values

# ---- LLM Provider ----
# OpenAI-compatible API endpoint
MODEL_BASE_URL=http://localhost:8080
# API key (required for OpenAI, optional for local llama.cpp)
MODEL_API_KEY=
# Model identifier (auto-inferred from MODEL_BASE_URL if not set)
MODEL_NAME=

# ---- Server ----
# Server auth token (set to enable Bearer token auth on /invoke)
# API_KEY=my-secret-key
# Server host and port
# CONFIG_PATH=

# ---- Logging ----
# RUST_LOG=debug
